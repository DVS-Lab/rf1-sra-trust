library(readxl)
library(ggplot2)
library(broom)
# Read the data from the Excel file
file_path <- "/Users/avidachs/Documents/GitHub/rf1-sra-trust/SFN/Trust Behavioral Analysis/IOS/iosXage.xlsx"
data <- read_excel(file_path)
# Fit a linear model
lm_model <- lm(iosF_S ~ age, data)
# Extract the p-value
p_value <- tidy(lm_model)$p.value
# Create the scatterplot with a line of best fit and error bars
ggplot(data, aes(x = age, y = iosF_S)) +
geom_point() +
stat_smooth(method = "lm", formula = y ~ x, color = "blue", se = TRUE) +
labs(title = "Scatterplot of Age vs. iosF_S with Error Bars",
x = "Age",
y = "iosF_S")
geom_text(x = max(data$age), y = max(data$iosF_S), label = paste("p =", round(p_value, 4)), hjust = 1, vjust = 1, size = 4)
summary(lm_model)
