# Read the data from the Excel file
data <- read_excel("/Users/avidachs/Documents/GitHub/rf1-sra-trust/SFN/precuneus activation mask/precuniusXage.xlsx")
# Fit a linear model and calculate confidence intervals
lm_model <- lm(precuneus_act ~ age, data)
predictions <- predict(lm_model, interval = "confidence", level = 0.95)
# Create the scatterplot with a line of best fit and error bars
ggplot(data, aes(x = age, y = precuneus_act)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
geom_line(data = predictions, aes(y = fit), color = "blue") +
geom_ribbon(data = predictions, aes(ymin = lwr, ymax = upr), fill = "blue", alpha = 0.2) +
labs(title = "Scatterplot of Age vs. Precuneus Activation with Error Bars",
x = "Age",
y = "Precuneus Activation")
